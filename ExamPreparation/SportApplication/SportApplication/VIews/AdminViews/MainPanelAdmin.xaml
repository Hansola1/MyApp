<Page x:Class="SportApplication.VIews.AdminViews.MainPanelAdmin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SportApplication.VIews.AdminViews"
      mc:Ignorable="d" 
      Title="MainPanelAdmin">

    <Grid Height="600" Width="800" Background="White">
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Panel.ZIndex="1"></Frame>

        <TextBlock HorizontalAlignment="Left" Margin="10,29,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="36" Height="56" Width="295"><Run Language="ru-ru" Text="Спорт-инвентарь"/></TextBlock>

        <DataGrid x:Name="InvetoryDataGrid" Margin="0,90,0,300"/>
        <DataGrid x:Name="UsersDataGrid" Margin="0,330,0,60"/>

        <Button Click="Set_Click" Content="Вернуть" HorizontalAlignment="Left" Margin="214,557,0,0" VerticalAlignment="Top" Height="33" Width="186" FontSize="18"/>
        <Button Click="Get_Click" Content="Выдать" HorizontalAlignment="Left" Margin="10,557,0,0" VerticalAlignment="Top" Height="33" Width="186" FontSize="18"/>

        <Button Click="Add_Click" Content="Добавить" HorizontalAlignment="Left" Margin="310,41,0,0" VerticalAlignment="Top" Height="33" Width="157" FontSize="18"/>
        <Button Click="Delete_Click" Content="Удалить" HorizontalAlignment="Left" Margin="472,41,0,0" VerticalAlignment="Top" Height="33" Width="136" FontSize="18"/>
        <Button Click="Edit_Click" Content="Изменить" HorizontalAlignment="Left" Margin="613,41,0,0" VerticalAlignment="Top" Height="33" Width="177" FontSize="18"/>
    </Grid>
</Page>