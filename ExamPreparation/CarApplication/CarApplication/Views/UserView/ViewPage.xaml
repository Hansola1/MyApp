<Page x:Class="CarApplication.Views.UserView.ViewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CarApplication.Views.UserView"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ViewPage">

    <Grid Height="450" Width="800" Background="White">
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Panel.ZIndex="1"></Frame>

        <!--Таблица-->
        <Border Background="White" Margin="20,69,22,46">
            <DataGrid x:Name="CarsDataGrid" Background="#FFE3E3E3">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Артикул книги" Binding="{Binding ArticleNumber}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Название книги" Binding="{Binding Title}" Width="200" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="110" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock HorizontalAlignment="Left" Margin="20,22,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="178" FontSize="18" Height="27"><Run Language="ru-ru" Text="Список всех машин"/></TextBlock>

        <Button Content="Взять" HorizontalAlignment="Left" Margin="20,420,0,0" VerticalAlignment="Top" Width="128"/>
        <Button Content="Списать" HorizontalAlignment="Left" Margin="164,420,0,0" VerticalAlignment="Top" Width="128"/>
    </Grid>
</Page>
