<Page x:Class="CarApplication.Views.Authorization"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CarApplication.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Authorization">

    <Grid Height="450" Width="800" Background="White">
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Panel.ZIndex="1"></Frame>

        <TextBox x:Name="LoginTextBox" HorizontalAlignment="Left" Margin="216,166,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="341" Height="27"/>
        <TextBox x:Name="PasswordTextBox" HorizontalAlignment="Left" Margin="216,225,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="341" Height="27"/>

        <TextBlock HorizontalAlignment="Left" Margin="156,166,0,0" TextWrapping="Wrap" Text="Логин" VerticalAlignment="Top" Width="44"/>
        <TextBlock HorizontalAlignment="Left" Margin="151,230,0,0" TextWrapping="Wrap" Text="Пароль" VerticalAlignment="Top" Width="60"/>

        <Button Content="Зарегистрироваться" HorizontalAlignment="Left" Margin="214,332,0,0" VerticalAlignment="Top" Width="346" Height="30" Click="Registration_Click"/>
        <Button Content="Войти" HorizontalAlignment="Left" Margin="214,285,0,0" VerticalAlignment="Top" Width="346" Height="30" Click="Login_Click"/>
        <TextBlock HorizontalAlignment="Left" Margin="301,102,0,0" TextWrapping="Wrap" Text="Авторизация" VerticalAlignment="Top" Width="131" FontSize="20"/>
    </Grid>
</Page>
