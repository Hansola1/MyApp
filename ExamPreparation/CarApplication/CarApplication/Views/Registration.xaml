<Page x:Class="CarApplication.Views.Registration"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CarApplication.Views"
      mc:Ignorable="d" Height="450" Width="800"
      Title="Registration">

    <Grid Height="450" Width="800" Background="White">
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Panel.ZIndex="1"></Frame>

        <TextBox x:Name="LoginTextBox" HorizontalAlignment="Left" Margin="221,88,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="341" Height="27"/>
        <TextBox x:Name="PasswordTextBox" HorizontalAlignment="Left" Margin="221,134,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="341" Height="27"/>
        <TextBox x:Name="NameTextBox" HorizontalAlignment="Left" Margin="221,184,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="341" Height="27"/>
        <TextBox x:Name="SurnameTextBox" HorizontalAlignment="Left" Margin="221,268,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="341" Height="27"/>
        <TextBox x:Name="PhoneTextBox" HorizontalAlignment="Left" Margin="221,225,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="341" Height="27"/>

        <TextBlock HorizontalAlignment="Left" Margin="156,93,0,0" TextWrapping="Wrap" Text="Логин" VerticalAlignment="Top" Width="44"/>
        <TextBlock HorizontalAlignment="Left" Margin="156,143,0,0" TextWrapping="Wrap" Text="Пароль" VerticalAlignment="Top" Width="60"/>
        <TextBlock HorizontalAlignment="Left" Margin="156,193,0,0" TextWrapping="Wrap" Text="Имя" VerticalAlignment="Top" Width="60"/>
        <TextBlock HorizontalAlignment="Left" Margin="156,234,0,0" TextWrapping="Wrap" Text="Фамилия" VerticalAlignment="Top" Width="60"/>
        <TextBlock HorizontalAlignment="Left" Margin="156,273,0,0" TextWrapping="Wrap" Text="Телефон" VerticalAlignment="Top" Width="60"/>

        <Button Content="Зарегистрироваться" HorizontalAlignment="Left" Margin="218,310,0,0" VerticalAlignment="Top" Width="346" Height="30" Click="Registration_Click"/>
        <Button Content="Есть аккаунт" HorizontalAlignment="Left" Margin="216,349,0,0" VerticalAlignment="Top" Width="346" Height="30" Click="Login_Click"/>
        <TextBlock HorizontalAlignment="Left" Margin="305,29,0,0" TextWrapping="Wrap" Text="Регистрация" VerticalAlignment="Top" Width="121" FontSize="20"/>
    </Grid>
</Page>
