<Page x:Class="CarApplication.Views.UserViews.MyViewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CarApplication.Views.UserViews"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MyViewPage">

    <Grid Height="450" Width="800" Background="White">
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Panel.ZIndex="1"></Frame>

        <TextBlock HorizontalAlignment="Left" Margin="20,22,0,0" TextWrapping="Wrap"
                   VerticalAlignment="Top" Width="178" FontSize="18" Height="27"><Run Language="ru-ru" Text="Список моих машин"/></TextBlock>

        <!--Таблица машин-->
        <StackPanel x:Name="DataGridContainer1" Background="White" Margin="20,69,22,52">
            <DataGrid x:Name="CarsDataGrid" Background="#FFE3E3E3" Height="330"></DataGrid>
        </StackPanel>

        <Button Content="Назад" HorizontalAlignment="Left" Margin="20,411,0,0" VerticalAlignment="Top" Width="272" Click="Cancel_click" Height="29"/>
    </Grid>
</Page>
